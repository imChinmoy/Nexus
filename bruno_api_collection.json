        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/auth/me",
              "host": ["http://localhost:5000"],
              "path": ["api", "v1", "auth", "me"]
            }
          },
          "response": [
