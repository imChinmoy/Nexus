      "name": "1. Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/auth/login",
              "host": ["http://localhost:5000"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@brlnexus.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "response": [
            {
              "name": "Successful Login",
              "originalRequest": {},
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"success\": true,\n  \"message\": \"Login successful\",\n  \"data\": {\n    \"user\": {\n      \"_id\": \"6a6d20635e01751ed7df1996\",\n      \"name\": \"Super Admin\",\n      \"email\": \"admin@brlnexus.com\",\n      \"role\": \"super_admin\"\n    },\n    \"accessToken\": \"eyJhbGciOiJIUzI...\",\n    \"refreshToken\": \"eyJhbGciOiJIUzI...\"\n  }\n}"
            }
          ]
